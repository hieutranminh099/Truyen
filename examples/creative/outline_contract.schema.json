{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hợp đồng dàn ý Creative Intelligence sau chuẩn hóa",
  "type": "object",
  "required": ["chapters"],
  "properties": {
    "schema_version": {"type": "string"},
    "story_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string"},
    "theme": {"type": "string"},
    "genre": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/strings"}]},
    "premise": {"type": "string"},
    "world": {"type": ["string", "object"]},
    "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
    "creative": {"$ref": "#/$defs/story_rules"},
    "chapters": {
      "type": "array", "minItems": 1, "maxItems": 1500,
      "items": {"$ref": "#/$defs/chapter"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "v4_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "character": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string"},
        "traits": {"type": "string"},
        "goal": {"type": "string"},
        "secret": {"type": "string"}
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "scenes"],
      "properties": {
        "id": {"$ref": "#/$defs/v4_id"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "scenes": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {"$ref": "#/$defs/scene"}
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "goal", "beats"],
      "properties": {
        "id": {"$ref": "#/$defs/v4_id"},
        "title": {"type": "string"},
        "pov": {"type": "string"},
        "goal": {"type": "string", "minLength": 1},
        "beats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_include": {"$ref": "#/$defs/strings"},
        "forbidden": {"$ref": "#/$defs/strings"},
        "continuity_requirements": {"$ref": "#/$defs/strings"},
        "emotional_arc": {"type": "string"},
        "creative_freedom": {"type": "string"},
        "target_words": {"type": "integer", "minimum": 1},
        "creative": {"$ref": "#/$defs/scene_rules"}
      }
    },
    "scene_ref": {
      "type": "object",
      "required": ["chapter_id", "scene_id"],
      "properties": {
        "chapter_id": {"$ref": "#/$defs/v4_id"},
        "scene_id": {"$ref": "#/$defs/v4_id"}
      }
    },
    "knowledge_ref": {
      "type": "object",
      "required": ["character", "fact_id"],
      "properties": {
        "character": {"type": "string", "minLength": 1},
        "fact_id": {"$ref": "#/$defs/id"}
      }
    },
    "story_rules": {
      "type": "object",
      "properties": {
        "initial_conditions": {"$ref": "#/$defs/strings"},
        "initial_knowledge": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/knowledge_ref"},
              {"required": ["state"], "properties": {"state": {"enum": ["known", "unknown", "suspected"]}}}
            ]
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reveal_from"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "reveal_from": {"$ref": "#/$defs/scene_ref"}
            }
          }
        }
      }
    },
    "scene_rules": {
      "type": "object",
      "properties": {
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/scene_ref"}},
        "reveal_secrets": {"$ref": "#/$defs/strings"},
        "forbid_secrets": {"$ref": "#/$defs/strings"},
        "beat_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["beat"],
            "properties": {
              "beat": {"type": "integer", "minimum": 1},
              "requires": {"$ref": "#/$defs/strings"},
              "establishes": {"$ref": "#/$defs/strings"},
              "knowledge_used": {"type": "array", "items": {"$ref": "#/$defs/knowledge_ref"}},
              "knowledge_learned": {"type": "array", "items": {"$ref": "#/$defs/knowledge_ref"}}
            }
          }
        }
      }
    }
  }
}
